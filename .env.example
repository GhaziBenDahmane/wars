# Required for `agentwars race`
QUIZ_SC_EMAIL=
# Leaderboard name; leave empty to race without submitting the score
QUIZ_SC_NICKNAME=

# `agentwars serve` races non-stop as AMUNDI STU SQUAD, one race at a time,
# taking turns between the comma-separated prefixes. Each makes
# {prefix}{i}@amundi.com emails, QUIZ_SC_ATTEMPTS_PER_EMAIL races each. The next
# race is saved in QUIZ_SC_RUNS_DIR/next_race_{prefix}; QUIZ_SC_EMAIL_START only
# raises the index.
QUIZ_SC_EMAIL_PREFIXES=ghazi_
# 1: every other race uses HTTP/1.1 instead of HTTP/2
QUIZ_SC_ALTERNATE_HTTP=
QUIZ_SC_EMAIL_START=1
QUIZ_SC_ATTEMPTS_PER_EMAIL=10
PORT=3000

# Optional
QUIZ_SC_URL=https://superchallenge.io/play/SUPERCHALLENGE-JAWVUX
QUIZ_SC_LOCALE=fr
# Independent routes used by bench only; races always use two
QUIZ_SC_CONNECTIONS=2
# Fresh curl probes for bench only (0-10); curl >= 7.83 required unless disabled
QUIZ_SC_NETWORK_PROBES=3
# Duplicate an answer on the second connection when the first is slower than this
QUIZ_SC_HEDGE_MS=150
QUIZ_SC_MAX_REQUESTS=4
# 1 forces HTTP/1.1 instead of HTTP/2 (for comparison)
QUIZ_SC_HTTP1=
QUIZ_SC_CHROME=chromium
QUIZ_SC_PROFILE=
QUIZ_SC_CDP_URL=
# Load the real play page for Turnstile instead of a stub (slower).
QUIZ_SC_REAL_PAGE=false
QUIZ_SC_TURNSTILE_TIMEOUT_S=60
QUIZ_SC_TURNSTILE_TOKEN=
QUIZ_SC_RUNS_DIR=/data/runs

# Optional LLM fallback for prompts no exact solver knows (OpenAI-compatible)
QUIZ_LLM_URL=
QUIZ_LLM_API_KEY=
QUIZ_LLM_MODEL=gpt-5.6-luna
# Abort a race once this many answers are in if they took longer than
# QUIZ_SC_ABORT_MS in total (0: never). Aborted races are not submitted.
QUIZ_SC_ABORT_AFTER=0
QUIZ_SC_ABORT_MS=1500
# Send the answers without Chrome's user agent and cookie (the run is still
# started with them). serve can alternate with QUIZ_SC_HEADERS_LIST=chrome,bare.
QUIZ_SC_BARE_ANSWERS=false
# Abort once the race cannot finish under this even at QUIZ_SC_ABORT_FAST_MS
# for every answer left (0: never), from QUIZ_SC_ABORT_AFTER answers on.
QUIZ_SC_ABORT_TARGET_MS=0
QUIZ_SC_ABORT_FAST_MS=33
# serve: one race in this many never aborts, for measurements (0: never)
QUIZ_SC_FULL_EVERY=0
# Send answers twice at once. Nonzero with QUIZ_SC_WINDOW_LIMIT: whenever the
# run's sliding-window limit (250 per 10 s) allows, keeping
# QUIZ_SC_WINDOW_RESERVE requests free; without it, this many spare requests.
QUIZ_SC_DUPLICATES=0
QUIZ_SC_WINDOW_LIMIT=0
QUIZ_SC_WINDOW_MS=10000
QUIZ_SC_WINDOW_RESERVE=3
# Send startRunV2 this far into a window (e.g. 6000), so the race spans two.
QUIZ_SC_START_PHASE_MS=
# Wait this long before each answer (for experiments)
QUIZ_SC_THINK_MS=0
# With QUIZ_SC_BARE_ANSWERS, also drop x-product-id, origin and referer
QUIZ_SC_MINIMAL_ANSWERS=false
# The backup route connects to this host:port instead (e.g. a tunnel)
QUIZ_SC_BACKUP_ADDR=
# serve lists (comma-separated), one combination per race in turn:
# QUIZ_SC_DUPLICATES_LIST, QUIZ_SC_THINK_MS_LIST, QUIZ_SC_PAGE_LIST=stub,real,
# QUIZ_SC_HEADERS_LIST=chrome,bare,minimal, QUIZ_SC_HEDGE_MS_LIST, QUIZ_SC_EDGE_IPS
