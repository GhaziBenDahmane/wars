# Required for `agentwars race`
QUIZ_SC_EMAIL=
# Leaderboard name; leave empty to race without submitting the score
QUIZ_SC_NICKNAME=

# `agentwars serve` races non-stop as AMUNDI STU SQUAD, one race at a time,
# taking turns between the comma-separated prefixes. Each makes
# {prefix}{i}@amundi.com emails, QUIZ_SC_ATTEMPTS_PER_EMAIL races each. The next
# race is saved in QUIZ_SC_RUNS_DIR/next_race_{prefix}; QUIZ_SC_EMAIL_START only
# raises the index.
QUIZ_SC_EMAIL_PREFIXES=ghazi_
# 1: every other race uses HTTP/1.1 instead of HTTP/2
QUIZ_SC_ALTERNATE_HTTP=
QUIZ_SC_EMAIL_START=1
QUIZ_SC_ATTEMPTS_PER_EMAIL=10
PORT=3000

# Optional
QUIZ_SC_URL=https://superchallenge.io/play/SUPERCHALLENGE-JAWVUX
QUIZ_SC_LOCALE=fr
# Independent routes used by bench only; races always use two
QUIZ_SC_CONNECTIONS=2
# Fresh curl probes for bench only (0-10); curl >= 7.83 required unless disabled
QUIZ_SC_NETWORK_PROBES=3
# Duplicate an answer on the second connection when the first is slower than this
QUIZ_SC_HEDGE_MS=150
QUIZ_SC_MAX_REQUESTS=4
# 1 forces HTTP/1.1 instead of HTTP/2 (for comparison)
QUIZ_SC_HTTP1=
QUIZ_SC_CHROME=chromium
QUIZ_SC_PROFILE=
QUIZ_SC_CDP_URL=
# Load the real play page for Turnstile instead of a stub (slower).
QUIZ_SC_REAL_PAGE=false
QUIZ_SC_TURNSTILE_TIMEOUT_S=60
QUIZ_SC_TURNSTILE_TOKEN=
QUIZ_SC_RUNS_DIR=/data/runs

# Optional LLM fallback for prompts no exact solver knows (OpenAI-compatible)
QUIZ_LLM_URL=
QUIZ_LLM_API_KEY=
QUIZ_LLM_MODEL=gpt-5.6-luna
